{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aventics.local/contracts/manifest/v1/schema.json",
  "title": "Aventics Component Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "type", "maturity", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^aventics\\.[a-z0-9][a-z0-9.-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "type": { "enum": ["extension", "app", "service", "agent-asset"] },
    "maturity": { "enum": ["experimental", "incubating", "managed", "stable", "deprecated", "retired"] },
    "host": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": { "type": { "type": "string" } }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "supported": { "type": "boolean" } }
    },
    "docs": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "path": { "type": "string" } }
    }
  }
}
