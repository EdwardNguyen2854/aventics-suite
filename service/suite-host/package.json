{
  "name": "@aventics/suite-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local control-plane service for Aventics Suite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test dist/tests/suite-host.test.js",
    "check": "npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
