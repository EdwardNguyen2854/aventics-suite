{
  "name": "@aventics/suite-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local control-plane service for Aventics Suite",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=bundle/suite-host.mjs",
    "start": "node --enable-source-maps dist/src/main.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test dist/tests/suite-host.test.js",
    "check": "npm test && npm run bundle"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  }
}
